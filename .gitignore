# Служебные и временные файлы (в репозиторий не попадают)
*.log
server.log
__pycache__/
*.pyc

# Рабочие данные приложения: база, загруженные PDF-сканы, архивы копий, логи.
# В git намеренно не версионируются (секреты и персональные данные),
# но файл version.json остаётся в репозитории — он нужен для модуля обновления.
data/*
!data/version.json
