     <td>{{ loop.index }}</td>
@@ -99,5 +110,38 @@ function openEdit(b){
   document.getElementById('editPanel').style.display = 'block';
   document.getElementById('editPanel').scrollIntoView({behavior:'smooth'});
 }
+
+// ===== Фильтрация журнала по столбцам (воронки) =====
+function toggleFilter(f){
+  const inp = f.parentElement.querySelector('.col-filter');
+  inp.hidden = !inp.hidden;
+  if(!inp.hidden) inp.focus();
+  else { inp.value=''; applyFilters(); }
+}
+
+function applyFilters(){
+  const table = document.getElementById('journalTable');
+  const filters = [...document.querySelectorAll('#journalTable .col-filter')]
+    .filter(i => i.value.trim());
+  let shown = 0;
+  table.querySelectorAll('tbody tr, tr:not(.filter-row)').forEach(tr => {
+    if(tr.querySelector('th') || tr.classList.contains('filter-row')) return; // строка заголовков
+    const cells = tr.children;
+    let visible = true;
+    for(const f of filters){
+      const c = cells[+f.dataset.col];
+      const text = (c ? c.textContent : '').toLowerCase();
+      if(!text.includes(f.value.trim().toLowerCase())){ visible = false; break; }
+    }
+    tr.style.display = visible ? '' : 'none';
+    if(visible && cells.length > 1) shown++;
+  });
+  const cnt = document.getElementById('filterCount');
+  if(cnt) cnt.textContent = filters.length ? ('Показано строк: ' + shown) : '';
+}
+
+document.addEventListener('input', e => {
+  if(e.target.classList && e.target.classList.contains('col-filter')) applyFilters();
+});
 </script>
 {% endblock %}
